# Privytics tracking its own marketing site.
#
# Leave unset and no analytics script is emitted at all, which is what you want
# locally and in CI. Set it in the production build environment to switch it on.
#
# Create the project in the dashboard, then copy its Client ID from
# Project settings -> Clients.
NEXT_PUBLIC_PRIVYTICS_CLIENT_ID=""

# Optional. Defaults to https://api.privytics.com.
# NEXT_PUBLIC_PRIVYTICS_API_URL="https://api.privytics.com"
