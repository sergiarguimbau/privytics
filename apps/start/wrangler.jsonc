{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "privytics-dashboard",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "routes": [
    {
      "pattern": "app.privytics.com/*",
      "zone_name": "privytics.com"
    }
  ],
  "vars": {
    "API_URL": "https://api.privytics.com",
    "DASHBOARD_URL": "https://app.privytics.com",
    "NODE_ENV": "production",
    "APP_VERSION": "1.0.0"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
